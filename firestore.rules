rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isRuntimeAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "viniamaral2026@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isRuntimeAdmin();
      allow delete: if isRuntimeAdmin();
    }

    // Projects
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Agents
    match /agents/{agentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Audits
    match /audits/{auditId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Sources
    match /sources/{sourceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Evidence
    match /evidence/{evidenceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isRuntimeAdmin();
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
